# Django
DJANGO_SECRET_KEY=change-me-to-a-real-secret-key
DJANGO_DEBUG=True

# PostgreSQL
DATABASE_NAME=aura
DATABASE_USER=aura
DATABASE_PASSWORD=aura
DATABASE_HOST=localhost
DATABASE_PORT=5432

# Model Gateway
AI_PROVIDER=mock
AI_MODEL=mock-model
AI_ENDPOINT=
AI_TIMEOUT=30
AI_GATEWAY_MAX_RETRIES=2
AI_GATEWAY_RETRY_BACKOFF_BASE=5.0
AI_GATEWAY_RETRY_BACKOFF_FACTOR=3.0

# Embedding Provider
AI_EMBEDDING_PROVIDER=mock
AI_EMBEDDING_MODEL=mock-embedding
AI_EMBEDDING_DIMENSIONS=384

# RAG Configuration
AI_RAG_CHUNK_SIZE=512
AI_RAG_CHUNK_OVERLAP=50
AI_RAG_TOP_K=5
AI_RERANKER_MODEL=ms-marco-TinyBERT-L-2-v2
AI_RAG_RERANKER_MIN_SCORE=0.0001

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
